########################################
# ─── App settings ─────────────────────
########################################
PORT=8083
NODE_ENV=development          # change to "production" in prod

# Development mode - uses mocks when external services are unavailable
DEV_MODE=true
USE_MOCK_RESPONSES=true

########################################
# ─── Google Cloud / Gemini ───────────
########################################
GOOGLE_CLOUD_PROJECT=ai-prompt-coach-466304
# GOOGLE_APPLICATION_CREDENTIALS=/home/robertjamesallen1122/.config/gcloud/application_default_credentials.json
# Note: Commented out invalid hardcoded path - will use environment default or service account

# Gemini API key (required by @google/genai SDK)
# Note: This appears to be a demo/placeholder key - replace with valid key in production
GEMINI_API_KEY=AIzaSyAJz6zypOrsZeJzV2-g5mub4-9Q7RXX6oc

# Default model (optional convenience variable)
GENAI_MODEL=gemini-2.5-flash      # or gemini-2.5-pro, gemini-pro, etc.

########################################
# ─── Firestore (prompt history) ──────
########################################
FIRESTORE_COLLECTION=prompts
# FIRESTORE_KEY_PATH=/path/to/service-account.json   # only if you use a separate SA key

########################################
# ─── CORS ────────────────────────────
########################################
CORS_ALLOWED_ORIGIN=http://localhost:5173
